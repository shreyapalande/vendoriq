# Copy to .env (gitignored) and fill in. Never commit .env.

# --- Gemini (M1b). Only needed by the eval script and the worker, not by the API.
GEMINI_API_KEY=
GEMINI_MODEL=

# --- PostgreSQL in Docker (read by docker-compose.yml)
POSTGRES_USER=vendoriq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vendoriq
POSTGRES_PORT=5432

# --- Backend database URLs (same user/password/port as above).
# The test database is created by docker/postgres-init/01-create-test-db.sql.
# Tests refuse to run unless the test database name ends in _test.
DATABASE_URL=postgresql+psycopg://vendoriq:change-me@localhost:5432/vendoriq
TEST_DATABASE_URL=postgresql+psycopg://vendoriq:change-me@localhost:5432/vendoriq_test

# --- Seed (M3). Password given to every user scripts/seed.py creates (local dev only).
SEED_PASSWORD=

# --- Sessions (M4). Set to true whenever the app is served over HTTPS.
SESSION_COOKIE_SECURE=false

# --- Backend options
# true = log every SQL statement the ORM runs
SQL_ECHO=false
LOG_LEVEL=INFO
